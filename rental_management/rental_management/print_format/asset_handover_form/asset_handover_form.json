 "html": "<style>\r\n\r\n@media screen {\r\n    .print-format {\r\n        width: 9.4in;\r\n        padding: 0.15in;\r\n        min-height: 11.7in;\r\n    }\r\n}\r\n\r\nbody {\r\n    margin: 0 !important;\r\n    padding: 0 !important;\r\n}\r\n\r\ntable {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    table-layout: fixed;\r\n    margin: 0 !important;\r\n}\r\n\r\ntd, th {\r\n    border: 1px solid #000;\r\n    padding: 3px 5px;\r\n    font-size: 11px;\r\n    line-height: 1.1;\r\n}\r\n\r\n.bold { font-weight: 600; }\r\n.center { text-align: center; }\r\n.right { text-align: right; }\r\n.grey { background-color: #e6e6e6; }\r\n\r\n.title {\r\n    font-size: 16px;\r\n    font-weight: 700;\r\n}\r\n\r\n</style>\r\n\r\n{% set logo = frappe.db.get_single_value(\"Orion Settings\", \"company_logo\") %}\r\n\r\n<!-- ================= HEADER ================= -->\r\n<table style=\"border:2px solid #000; border-bottom:0;\">\r\n<tr>\r\n\r\n    <td style=\"width:30%; border-right:0;\">\r\n        {% if logo %}\r\n        <img src=\"{{ logo }}\" style=\"height:60px;\">\r\n        {% endif %}\r\n    </td>\r\n\r\n    <td class=\"center title\" style=\"width:40%; border-left:0; border-right:0;\">\r\n        ASSET HANDOVER FORM\r\n    </td>\r\n\r\n    <td style=\"width:30%;\">\r\n        Ref No:<br>\r\n        {{ doc.name }}<br><br>\r\n        Date:<br>\r\n        {{ frappe.utils.formatdate(doc.posting_date, \"dd-MM-yyyy\") }}\r\n    </td>\r\n\r\n</tr>\r\n</table>\r\n\r\n<!-- ================= EMPLOYEE DETAILS ================= -->\r\n<table style=\"border:2px solid #000; border-top:0; border-bottom:0;\">\r\n\r\n<tr>\r\n    <td class=\"grey bold\">Employee ID</td>\r\n    <td>{{ doc.employee }}</td>\r\n    <td class=\"grey bold\">Department</td>\r\n    <td>{{ doc.department }}</td>\r\n</tr>\r\n\r\n<tr>\r\n    <td class=\"grey bold\">Employee Name</td>\r\n    <td>{{ doc.employee_name }}</td>\r\n    <td class=\"grey bold\">Designation</td>\r\n    <td>{{ doc.designation }}</td>\r\n</tr>\r\n\r\n<tr>\r\n    <td class=\"grey bold\">Handover Date</td>\r\n    <td>{{ frappe.utils.formatdate(doc.posting_date, \"dd-MM-yyyy\") }}</td>\r\n    <td class=\"grey bold\">Location</td>\r\n    <td>{{ doc.branch or \"\" }}</td>\r\n</tr>\r\n\r\n</table>\r\n\r\n<!-- ================= ASSET DETAILS ================= -->\r\n<table style=\"border:2px solid #000; border-top:0;\">\r\n\r\n<tr class=\"grey bold center\">\r\n    <td style=\"width:5%;\">#</td>\r\n    <td style=\"width:25%;\">Asset Name</td>\r\n    <td style=\"width:20%;\">Asset Code</td>\r\n    <td style=\"width:15%;\">Serial No</td>\r\n    <td style=\"width:15%;\">Condition</td>\r\n    <td style=\"width:20%;\">Remarks</td>\r\n</tr>\r\n\r\n{% for row in doc.assets or [] %}\r\n<tr>\r\n    <td class=\"center\">{{ loop.index }}</td>\r\n    <td>{{ row.asset_name }}</td>\r\n    <td>{{ row.asset }}</td>\r\n    <td>{{ row.serial_number or \"\" }}</td>\r\n    <td>{{ row.condition or \"Good\" }}</td>\r\n    <td>{{ row.remarks or \"\" }}</td>\r\n</tr>\r\n{% endfor %}\r\n\r\n</table>\r\n\r\n<!-- ================= DECLARATION ================= -->\r\n<table style=\"border:2px solid #000; border-top:0;\">\r\n<tr>\r\n<td style=\"height:70px; vertical-align:top;\">\r\n<b>Declaration:</b><br>\r\nI confirm that the above-mentioned assets have been received in good condition and I take full responsibility for them. I will return the same upon request or at the time of exit.\r\n</td>\r\n</tr>\r\n</table>\r\n\r\n<!-- ================= SIGNATURES ================= -->\r\n<table style=\"border:2px solid #000; border-top:0;\">\r\n\r\n<tr class=\"grey bold center\">\r\n    <td>Employee Signature</td>\r\n    <td>Issued By</td>\r\n    <td>Authorized By</td>\r\n</tr>\r\n\r\n<tr style=\"height:60px;\">\r\n    <td></td>\r\n    <td></td>\r\n    <td></td>\r\n</tr>\r\n\r\n<tr class=\"center\">\r\n    <td>{{ doc.employee_name }}</td>\r\n    <td>{{ frappe.session.user }}</td>\r\n    <td></td>\r\n</tr>\r\n\r\n</table>\r\n\r\n<!-- ================= FOOTER ================= -->\r\n<table style=\"border:2px solid #000; border-top:0;\">\r\n<tr>\r\n<td class=\"center\" style=\"font-size:10px;\">\r\nThis is a system-generated document and does not require a signature.\r\n</td>\r\n</tr>\r\n</table>",
